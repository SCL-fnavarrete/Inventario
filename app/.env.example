# Plantilla de variables de entorno. Copiar a `.env` y completar.
# Este archivo se versiona a proposito: documenta que hace falta, nunca valores.

# --- Base de datos (Neon) ---
# `DATABASE_URL_UNPOOLED` es la conexion directa que exige `directUrl` para las
# migraciones; la pooled no sirve para eso.
DATABASE_URL="postgresql://usuario:clave@host/base?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host-directo/base?sslmode=require"

# --- NextAuth ---
# En local tiene que ser el origen real del dev server: con el dominio de
# produccion aqui, las cookies salen `__Host-`/`__Secure-` y la sesion no pega.
NEXTAUTH_SECRET="<openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (Azure AD) ---
# Credenciales de aplicacion (client credentials). Las comparten la
# sincronizacion de empleados y el archivo de documentos en SharePoint.
# Permiso minimo para la sincronizacion: User.Read.All (solo lectura).
MICROSOFT_TENANT_ID="<tenant-id>"
MICROSOFT_CLIENT_ID="<application-client-id>"
MICROSOFT_CLIENT_SECRET="<client-secret>"

# --- SharePoint: archivo de documentos emitidos (Ola 2) ---
# Permiso de aplicacion: `Sites.ReadWrite.All` da acceso a todos los sitios;
# `Sites.Selected` es preferible y limita el acceso al sitio de evidencia, que
# hay que autorizar explicitamente sobre ese sitio.
#
# SHAREPOINT_SITE_ID sale de:
#   GET /v1.0/sites/{hostname}:/sites/{nombre}    -> campo `id`
# SHAREPOINT_DRIVE_ID sale de:
#   GET /v1.0/sites/{site-id}/drives              -> campo `id` de la biblioteca
# SHAREPOINT_FOLDER_PATH es la ruta dentro de esa biblioteca; puede tener
# espacios y acentos: el servicio codifica cada segmento.
SHAREPOINT_SITE_ID="contoso.sharepoint.com,<site-guid>,<web-guid>"
SHAREPOINT_DRIVE_ID="<drive-id>"
SHAREPOINT_FOLDER_PATH="Evidencia TI/Documentos emitidos"
