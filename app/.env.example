# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# Base de datos. En Neon: la URL del pooler en DATABASE_URL y la directa en
# DATABASE_URL_UNPOOLED (la usan las migraciones). En produccion siempre con
# sslmode=require. connection_limit acota las conexiones por instancia.
# Local: 127.0.0.1 y no localhost. Docker escucha solo en IPv4 y en Windows
# localhost prueba primero IPv6: cada conexion nueva tardaba ~2 s.
DATABASE_URL="postgresql://inventario:CAMBIAR@127.0.0.1:5433/inventario_it_dev?connection_limit=10&pool_timeout=20"
DATABASE_URL_UNPOOLED="postgresql://inventario:CAMBIAR@127.0.0.1:5433/inventario_it_dev"

# Clave de la base local de docker-compose.yml.
POSTGRES_PASSWORD="CAMBIAR"

# NextAuth. El secreto debe tener al menos 32 caracteres:
#   openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Solo si la app corre detras de un proxy propio que fija X-Forwarded-For
# (en Vercel no hace falta). Sin esto no se confia en esa cabecera.
# TRUST_PROXY="true"

# Primer administrador, lo crea `npm run db:seed`. La clave debe tener 12+
# caracteres con mayuscula, minuscula, numero y simbolo.
SEED_ADMIN_EMAIL="admin@sclconsultores.com"
SEED_ADMIN_PASSWORD=""
