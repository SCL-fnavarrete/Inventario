generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model SystemUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  nombre       String
  rol          SystemRole
  activo       Boolean    @default(true)
  ultimoLogin  DateTime?  @map("ultimo_login")
  // Sede a la que pertenece este usuario. `admin` la deja en null porque ve
  // todas las sedes; el resto (soporte/tecnico, etc.) queda restringido a
  // los datos de la suya -- ver sedeScope() y SPEC 2.9.
  sedeId       String?    @map("sede_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sede                Sede?             @relation(fields: [sedeId], references: [id])
  solicitudesCreadas  WorkflowRequest[] @relation("SolicitanteRelation")
  solicitudesAsignadas WorkflowRequest[] @relation("ResponsableRelation")
  workflowComments    WorkflowComment[]
  workflowTransitions WorkflowTransition[]

  @@index([sedeId])
  @@map("system_users")
}

model Employee {
  id                   String          @id @default(uuid())
  rut                  String?         @unique
  nombres              String          @map("nombre")
  apellidoPaterno      String          @map("apellido_paterno")
  apellidoMaterno      String?         @map("apellido_materno")
  // 15-sep-2026 (SPEC 2.39): se invierte cual de los dos correos es
  // obligatorio. Antes el obligatorio era el personal y el de empresa
  // opcional, al reves de como son los datos reales: el consolidado de
  // inventario (y cualquier planilla de soporte) trae la cuenta corporativa,
  // que es la que siempre existe y con la que se identifica a la persona en
  // el area de TI; el correo particular muchas veces nadie lo registro.
  correoPersonal       String?         @unique @map("correo_personal")
  correoEmpresa        String          @unique @map("correo_empresa")
  cargo                String?
  jefatura             String?
  supervisor           String?
  ubicacion            String?
  division             String?
  area                 String?
  subArea              String?         @map("sub_area")
  direccionParticular  String?         @map("direccion_particular")
  listasDistribucion   String?         @map("listas_distribucion")
  // Opcional desde el 15-sep-2026 (SPEC 2.39), pedido explicito de Javier:
  // "como no esta en el Excel... si lo dejamos opcional, inserta de manera
  // correcta los datos ahora y mas adelante los tecnicos tendran que
  // ingresarla". Era obligatorio, lo que obligaba a inventar un valor
  // ("contrato") para gente de la que no consta como esta contratada. Solo
  // se usa como etiqueta/filtro en pantalla, no condiciona ninguna regla.
  tipoContrato         TipoContrato?   @map("tipo_contrato")
  fechaIngreso         DateTime?       @map("fecha_ingreso")
  fechaTermino         DateTime?       @map("fecha_termino")
  estado               EstadoEmpleado  @default(activo)
  telefonoContacto     String?         @map("telefono_contacto")
  microsoftId          String?         @unique @map("microsoft_id")
  origenMicrosoft       Boolean         @default(false) @map("origen_microsoft")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  fechaEntregaEpp      DateTime?       @map("fecha_entrega_epp")
  fechaEntregaKit      DateTime?       @map("fecha_entrega_kit")
  proximaMantencionEpp DateTime?       @map("proxima_mantencion_epp")
  // Sede de quien registro al empleado -- determina que soporte lo ve.
  // Independiente de `ubicacion` (texto libre, ya existia). Ver SPEC 2.9.
  sedeId               String?         @map("sede_id")
  sede                 Sede?           @relation(fields: [sedeId], references: [id])
  activosActuales      Asset[]         @relation("EmpleadoActual")
  assignments          Assignment[]
  kitAssignments       KitAssignment[]
  terminations         Termination[]
  workflowRequests     WorkflowRequest[]

  @@index([estado])
  @@index([tipoContrato])
  @@index([ubicacion])
  @@index([jefatura])
  @@index([microsoftId])
  @@index([createdAt])
  @@index([sedeId])
  @@map("employees")
}

model AssetCategory {
  id            String   @id @default(uuid())
  nombre        String   @unique
  descripcion   String?
  requiereSerie Boolean  @default(true) @map("requiere_serie")
  requiereImei  Boolean  @default(false) @map("requiere_imei")
  // Umbral de "stock bajo" para la alerta del Dashboard, igual concepto que
  // WelcomeKitItem.stockMinimo pero aplicado a activos DISPONIBLES de esta
  // categoria (no al total): un notebook "asignado" no cuenta como stock,
  // es el que queda libre para entregar lo que le importa a soporte.
  stockMinimo   Int      @default(3) @map("stock_minimo")
  createdAt     DateTime @default(now()) @map("created_at")
  assets        Asset[]

  @@map("asset_categories")
}

model Asset {
  id                  String              @id @default(uuid())
  categoriaId         String              @map("categoria_id")
  numeroSerie         String?             @unique @map("numero_serie")
  imei                String?
  marca               String
  modelo              String
  procesador          String?
  discoDuro           String?             @map("disco_duro")
  ram                 String?
  pulgadas            Decimal?            @db.Decimal(4, 1)
  sistemaOperativo    String?             @map("sistema_operativo")
  numeroTelefono      String?             @map("numero_telefono")
  numeroActivacion    String?             @map("numero_activacion")
  tipoPlan            String?             @map("tipo_plan")
  // Campo "operador" (Entel/Movistar/WOM/Claro) eliminado 14-sep-2026,
  // pedido explicito de Javier -- ver migracion
  // 20260914000000_activos_quitar_operador_celular y SPEC 2.20.
  tieneCargador       Boolean             @default(true) @map("tiene_cargador")
  // Conectividad compartida por los perifericos simples (Mouse, Teclado,
  // Webcam, Audifonos) -- un solo campo en vez de cuatro secciones casi
  // idénticas, porque a esas categorias "basta con colocar su identificador
  // unico" (palabras de Javier) mas este dato. Impresora tuvo especificaciones
  // propias por un momento el mismo dia (tipo/conexion/IP) pero Javier decidio
  // que no eran necesarias -- se revirtio (ver migracion
  // 20260911230000_activos_revertir_specs_impresora y SPEC 2.11).
  conectividad        String?
  estado              EstadoActivo        @default(disponible)
  condicion           CondicionActivo     @default(nuevo)
  ubicacionFisica     String?             @map("ubicacion_fisica")
  microsoft365        Boolean             @default(false) @map("microsoft_365")
  // Nombre del plan/licencia (ej. "Premium", "E3") -- antes se perdia: el
  // Excel de Notebooks lo trae, pero solo se guardaba el booleano de arriba.
  // Ver migracion 20260914010000_activos_agregar_tipo_licencia_microsoft365
  // y SPEC 2.23 (14-sep-2026, pedido explicito de Javier).
  tipoLicenciaMicrosoft365 String?        @map("tipo_licencia_microsoft365")
  intuneEnrolled      Boolean             @default(false) @map("intune_enrolled")
  listaDistribucion   String?             @map("lista_distribucion")
  antivirus           String?             // Software antivirus instalado
  incidencia          String?             // Incidencias reportadas (robo, falla, etc)
  fechaCompra         DateTime?           @map("fecha_compra")
  fechaGarantiaFin    DateTime?           @map("fecha_garantia_fin")
  fechaBaja           DateTime?           @map("fecha_baja")
  // Fecha en que se vendio el activo (la que ingresa quien registra la
  // venta, no la fecha del sistema). Antes no existia ninguna columna para
  // esto y el historial guardaba siempre la fecha de hoy (14-sep-2026,
  // SPEC 2.25). Comprador/monto/moneda siguen solo en AssetHistory, igual
  // que antes -- Javier solo pidio la fecha, no un documento.
  fechaVenta          DateTime?           @map("fecha_venta")
  // Retira el activo de los listados sin borrar la fila ni su historial.
  // Para duplicados de importacion; ver SPEC 2.7.7. No reemplaza al estado
  // `baja`, que es un estado del ciclo de vida del equipo.
  deletedAt           DateTime?           @map("deleted_at")
  observaciones       String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  empleadoActualId    String?             @map("empleado_actual_id")
  nombreEquipo        String?             @map("nombre_equipo")
  // Sede donde esta almacenado FISICAMENTE el activo. Independiente de la
  // sede/ubicacion del empleado asignado -- no cambia por una asignacion o
  // devolucion, solo por una guia de despacho de tipo `traslado` ya
  // recibida. Ver SPEC 2.9 (Sedes).
  sedeId              String?             @map("sede_id")
  history             AssetHistory[]
  categoria           AssetCategory       @relation(fields: [categoriaId], references: [id])
  empleadoActual      Employee?           @relation("EmpleadoActual", fields: [empleadoActualId], references: [id])
  sede                Sede?               @relation(fields: [sedeId], references: [id])
  assignments         Assignment[]
  dispatchItems       DispatchGuideItem[]
  maintenances        Maintenance[]
  purchaseAssets      PurchaseAsset[]

  @@index([estado])
  @@index([categoriaId])
  @@index([empleadoActualId])
  @@index([sedeId])
  @@index([marca])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("assets")
}

// Modelo Supplier eliminado (14-sep-2026, pedido explicito de Javier: "elimina
// la tabla de proveedores"). Ya estaba desvinculado de Purchase desde el
// 11-sep-2026 (el area de soporte no necesita asociar una compra a un
// proveedor) y Javier confirmo que la tabla no se usaba. Ver migracion
// 20260914080000_elimina_proveedores y SPEC 2.35. Las rutas /api/proveedores
// y la pantalla de Configuracion > Proveedores quedaron como stubs que
// avisan que el modulo se elimino, en vez de borrarse (mismo criterio ya
// usado con otras paginas cuando no se puede borrar archivos).

// Compras (11-sep-2026, pedido explicito de Javier): se simplifico a solo
// dos datos -- la factura (para relacionarla) y los equipos que vinieron
// con ella. Se eliminaron el proveedor y todo dato financiero (monto
// total, moneda, metodo de pago, precio unitario por equipo): "el tema del
// dinero no es un dato que nos interese" para el area de soporte. Antes de
// este cambio esos campos ya estaban restringidos a admin (11-sep-2026,
// cambio anterior); ahora directamente no existen. Ver migracion
// 20260911200000_compras_solo_factura_y_equipos.
model Purchase {
  id             String          @id @default(uuid())
  numeroFactura  String?         @map("numero_factura")
  fechaFactura   DateTime        @map("fecha_factura")
  // RUT del proveedor que emitio la factura (11-sep-2026, pedido explicito
  // de Javier). Es solo texto libre validado con el mismo digito
  // verificador que el rut de un empleado (ver validations/rut.ts) -- no
  // referencia al catalogo Supplier, que sigue desvinculado de compras
  // (ver nota de la v1.9 en el changelog).
  rutProveedor   String?         @map("rut_proveedor")
  tipoCompra     TipoCompra      @default(FACTURA) @map("tipo_compra")
  descripcion    String?
  compradoPor    String?         @map("comprado_por")
  ordenCompra    String?         @map("orden_compra")
  // Sede a la que se le atribuye la compra (9-sep-2026, ver sedeScope.ts).
  // Obligatoria para admin desde el 11-sep-2026 (sedeIdParaCrear con
  // requerido: true, igual que activos/empleados/solicitudes/guias) --
  // sigue nullable en la columna solo por compatibilidad con filas
  // creadas antes de esa regla.
  sedeId         String?         @map("sede_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  purchaseAssets PurchaseAsset[]
  // Lineas de Kit/EPP compradas con esta factura (14-sep-2026, SPEC 2.36,
  // pedido explicito de Javier: "aveces el kit de bievenida o epp tambien
  // lo compran y aqui al registrar una factura ... solo funciona con los
  // equipos pero no con el kitt de bievenida o epp"). A diferencia de
  // PurchaseAsset, esto no crea una fila nueva por unidad -- Kit/EPP es
  // stock contable (ver WelcomeKitItem.cantidad), asi que cada linea suma
  // una cantidad al stock existente del articulo.
  purchaseKitItems PurchaseKitItem[]
  sede           Sede?           @relation(fields: [sedeId], references: [id])

  @@index([sedeId])
  @@map("purchases")
}

model PurchaseAsset {
  id         String   @id @default(uuid())
  purchaseId String   @map("purchase_id")
  assetId    String   @map("asset_id")
  createdAt  DateTime @default(now()) @map("created_at")
  asset      Asset    @relation(fields: [assetId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  @@map("purchase_assets")
}

// Linea de compra de Kit/EPP (14-sep-2026, SPEC 2.36). Cada fila registra
// cuanta cantidad de un articulo del catalogo (WelcomeKitItem) llego con
// esta factura -- al crearse, suma esa cantidad al stock del articulo; si
// la compra se elimina o la linea se desvincula, se resta de vuelta (sin
// bajar de 0, por si ya se entrego parte de ese stock a un empleado).
model PurchaseKitItem {
  id         String         @id @default(uuid())
  purchaseId String         @map("purchase_id")
  itemId     String         @map("item_id")
  cantidad   Int
  createdAt  DateTime       @default(now()) @map("created_at")
  purchase   Purchase       @relation(fields: [purchaseId], references: [id])
  item       WelcomeKitItem @relation(fields: [itemId], references: [id])

  @@index([purchaseId])
  @@index([itemId])
  @@map("purchase_kit_items")
}

model Assignment {
  id                      String            @id @default(uuid())
  assetId                 String            @map("asset_id")
  employeeId              String            @map("employee_id")
  fechaEntrega            DateTime          @map("fecha_entrega")
  lugarEntrega            String?           @map("lugar_entrega")
  entregadoPor            String?           @map("entregado_por")
  tipoMovimiento          TipoMovimiento    @map("tipo_movimiento")
  motivo                  String?
  fechaDevolucion         DateTime?         @map("fecha_devolucion")
  recibidoPor             String?           @map("recibido_por")
  estadoDevolucion        EstadoDevolucion? @map("estado_devolucion")
  observacionesDevolucion String?           @map("observaciones_devolucion")
  // Condicion del cargador -- solo tiene sentido si el activo es un
  // notebook con tieneCargador = true; para el resto queda null. No es un
  // activo propio, es un atributo de esta entrega/devolucion puntual y no
  // afecta el estado/condicion del Activo. Ver SPEC 2.5.3 regla 9.
  condicionCargadorEntrega    EstadoDevolucionTipo? @map("condicion_cargador_entrega")
  condicionCargadorDevolucion EstadoDevolucionTipo? @map("condicion_cargador_devolucion")
  observacionesCargador       String?               @map("observaciones_cargador")
  activo                  Boolean           @default(true)
  actaEntregaUrl          String?           @map("acta_entrega_url")
  actaDevolucionUrl       String?           @map("acta_devolucion_url")
  firmaEmpleadoEntrega    String?           @map("firma_empleado_entrega")
  firmaEmpleadoDevolucion String?           @map("firma_empleado_devolucion")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  asset                   Asset             @relation(fields: [assetId], references: [id])
  employee                Employee          @relation(fields: [employeeId], references: [id])

  @@index([assetId])
  @@index([employeeId])
  @@index([activo])
  @@index([fechaEntrega])
  @@index([tipoMovimiento])
  @@map("assignments")
}

model WelcomeKitItem {
  id             String          @id @default(uuid())
  nombre         String
  categoria      CategoriaKit
  // Stock disponible de este articulo. Baja al entregar (KitAssignment),
  // sube si se devuelve. Es un conteo simple, no unidades individuales
  // rastreables (a diferencia de Asset) -- para EPP/Kit no hace falta
  // distinguir una unidad de otra, solo saber cuantas quedan.
  cantidad       Int              @default(0)
  // Umbral configurable para la alerta de "stock bajo" del Dashboard: se
  // avisa cuando cantidad llega a este numero o menos (y por separado cuando
  // llega a 0, "sin stock"). Cada articulo puede tener su propio umbral --
  // no todos se agotan al mismo ritmo.
  stockMinimo    Int              @default(5) @map("stock_minimo")
  // Catalogo separado por sede (SPEC 2.9): cada sede tiene sus propias filas
  // y su propio stock, igual que Asset/Employee -- no es un catalogo global
  // con un stock compartido. Nullable por el mismo motivo que en los demas
  // modelos con sede: un registro "sin sede" solo lo ve admin.
  sedeId         String?          @map("sede_id")
  sede           Sede?            @relation(fields: [sedeId], references: [id])
  createdAt      DateTime         @default(now()) @map("created_at")
  kitAssignments KitAssignment[]
  requeridoEn    RequestKitItem[]
  // Compras que trajeron stock de este articulo (14-sep-2026, SPEC 2.36).
  purchaseKitItems PurchaseKitItem[]

  @@index([sedeId])
  @@map("welcome_kit_items")
}

model KitAssignment {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  itemId        String           @map("item_id")
  // Solicitud de onboarding que origino esta entrega. Nullable porque el
  // modelo tambien admite entregas sueltas (no ligadas a un ticket), igual
  // que ya pasaba antes de que hubiera Solicitudes.
  requestId     String?          @map("request_id")
  cantidad      Int              @default(1)
  fechaEntrega  DateTime         @map("fecha_entrega")
  estado        EstadoKit        @default(entregado)
  observaciones String?
  createdAt     DateTime         @default(now()) @map("created_at")
  employee      Employee         @relation(fields: [employeeId], references: [id])
  item          WelcomeKitItem   @relation(fields: [itemId], references: [id])
  request       WorkflowRequest? @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("kit_assignments")
}

/// Lista de articulos de Kit/EPP que una solicitud de onboarding pidio, uno
/// por uno (zapatos, casco, chaleco...), con el estado de cada uno. Es la
/// version detallada de las banderas kitBienvenidaSolicitado/eppSolicitado:
/// esas dicen "corresponde entregar EPP", esta dice exactamente que articulos
/// y si cada uno ya se entrego o se descarto. El ticket no cierra mientras
/// quede alguno en "pendiente".
model RequestKitItem {
  id             String             @id @default(uuid())
  requestId      String             @map("request_id")
  itemId         String             @map("item_id")
  cantidad       Int                @default(1)
  estado         EstadoKitRequerido @default(pendiente)
  motivoNoAplica String?            @map("motivo_no_aplica")
  resueltoPor    String?            @map("resuelto_por")
  resueltoEn     DateTime?          @map("resuelto_en")
  createdAt      DateTime           @default(now()) @map("created_at")
  request        WorkflowRequest    @relation(fields: [requestId], references: [id])
  item           WelcomeKitItem     @relation(fields: [itemId], references: [id])

  @@unique([requestId, itemId])
  @@index([requestId])
  @@map("request_kit_items")
}

// Tipos de mantencion (9-sep-2026): antes era un enum fijo de Postgres
// (TipoMantencion), pedido por Javier para que sea mantenible sin tocar
// codigo/deploy. Admin y tecnico pueden crear/editar/eliminar tipos por
// igual (recurso de permisos "tiposMantencion", ver permissions.ts) -- es
// una decision operativa del dia a dia, no algo que deba quedar detras de
// Configuracion (que es solo para lo fijo del sistema). No tiene sedeId:
// es un catalogo global, mismo criterio que AssetCategory.
model MaintenanceType {
  id           String        @id @default(uuid())
  nombre       String        @unique
  descripcion  String?
  // Permite "retirar" un tipo sin borrarlo (y sin romper las mantenciones
  // que ya lo usan) -- se deja de ofrecer en el selector pero las
  // mantenciones existentes lo siguen mostrando.
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  maintenances Maintenance[]

  @@map("maintenance_types")
}

model Maintenance {
  id                String           @id @default(uuid())
  assetId           String           @map("asset_id")
  tipoId            String           @map("tipo_id")
  descripcion       String
  fechaProgramada   DateTime?        @map("fecha_programada")
  fechaRealizada    DateTime?        @map("fecha_realizada")
  proximaMantencion DateTime?        @map("proxima_mantencion")
  realizadoPor      String?          @map("realizado_por")
  costo             Decimal?         @db.Decimal(10, 2)
  proveedorExterno  String?          @map("proveedor_externo")
  estado            EstadoMantencion @default(pendiente)
  resultado         String?
  // Resultado estructurado (14-sep-2026, SPEC 2.25): "reparado" |
  // "no_reparable" | "pendiente_repuestos" (ver resultadoMantencionEnum).
  // `resultado` de arriba sigue siendo la descripcion libre de que se hizo;
  // esto es lo que decide que pasa con el activo al completar. Nullable
  // porque las mantenciones ya completadas antes de este cambio no lo tienen.
  resultadoTipo     String?          @map("resultado_tipo")
  // Motivo de la baja, obligatorio solo cuando resultadoTipo=no_reparable.
  motivoBaja        String?          @map("motivo_baja")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  asset             Asset            @relation(fields: [assetId], references: [id])
  tipo              MaintenanceType  @relation(fields: [tipoId], references: [id])

  @@index([assetId])
  @@index([estado])
  @@index([tipoId])
  @@index([fechaProgramada])
  @@map("maintenances")
}

model AssetHistory {
  id              String     @id @default(uuid())
  assetId         String     @map("asset_id")
  tipoEvento      TipoEvento @map("tipo_evento")
  descripcion     String
  datosAnteriores Json?      @map("datos_anteriores")
  datosNuevos     Json?      @map("datos_nuevos")
  usuarioSistema  String?    @map("usuario_sistema")
  createdAt       DateTime   @default(now()) @map("created_at")
  asset           Asset      @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([tipoEvento])
  @@index([createdAt])
  @@map("asset_history")
}

// Auditoria generica de escritura (SPEC 2.29, 14-sep-2026): a diferencia de
// AssetHistory (dedicado a Activos, con relacion propia y TipoEvento
// especifico), esta tabla cubre Empleado/Compra/Usuario -- los 3 modulos que
// hoy solo dejan `updatedAt` en la fila, sin quien ni que cambio. Se agrega
// porque desde SPEC 2.29 un tecnico puede crear/editar/eliminar datos de
// CUALQUIER sede (ya no solo la suya), y Javier condiciono abrir ese acceso
// a que "cualquier cosa quede un registro" ligado al usuario que la ejecuto.
//
// Deliberadamente generica/polimorfica (entidad + entidadId como texto, sin
// relacion FK a cada modelo) porque una sola tabla cubre 3 modelos distintos
// -- Prisma no soporta una FK que apunte a "uno de varios modelos". Mismo
// motivo por el que `usuarioSistema` es texto libre (email) y no una FK a
// SystemUser: sigue el mismo patron que AssetHistory.usuarioSistema.
//
// Excluido explicitamente: Proveedores. Javier fue explicito: "aclarar que
// proveedor no va a estar ya que es un dato que no tiene relevancia para el
// area de soporte". Ver SPEC 2.29 punto 4.
//
// IMPORTANTE: `datosAnteriores`/`datosNuevos` de Usuario NUNCA deben incluir
// `passwordHash` -- ver auditLogService y las rutas de /api/usuarios.
model AuditLog {
  id              String         @id @default(uuid())
  entidad         AuditEntidad
  entidadId       String         @map("entidad_id")
  accion          AuditAccion
  descripcion     String
  datosAnteriores Json?          @map("datos_anteriores")
  datosNuevos     Json?          @map("datos_nuevos")
  usuarioSistema  String?        @map("usuario_sistema")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("audit_log")
}

// Configuracion general del sistema (14-sep-2026, pedido explicito de
// Javier al revisar Configuracion > Parametros Generales -- esa pantalla
// era 100% decorativa: datos de ejemplo hardcodeados y el boton Guardar
// solo simulaba un delay, sin persistir nada).
//
// Fila unica (singleton): siempre se lee/escribe el registro con
// id = "singleton" -- no existe una UI para crear una segunda fila, y la
// API (/api/configuracion/parametros) hace upsert sobre ese id fijo.
//
// `duracionSesionHoras`/`maxIntentosLogin`/`minutosBloqueoLogin` reemplazan
// las constantes hasta ahora hardcodeadas en lib/auth.ts (maxAge 24h,
// MAX_ATTEMPTS 5, LOCKOUT_DURATION 15min). Un cambio aca solo afecta
// sesiones NUEVAS (login) -- una sesion ya activa mantiene la duracion con
// la que su JWT fue emitido, no se puede "cortar" a mitad de camino.
model SystemConfig {
  id                   String   @id @default("singleton")

  // Datos de la empresa: por ahora solo se guardan como referencia -- no se
  // usan en actas/reportes (Javier confirmo que no hace falta conectarlos).
  empresaNombre        String?  @map("empresa_nombre")
  empresaRut           String?  @map("empresa_rut")
  empresaDireccion     String?  @map("empresa_direccion")
  empresaTelefono      String?  @map("empresa_telefono")
  empresaEmail         String?  @map("empresa_email")
  empresaSitioWeb      String?  @map("empresa_sitio_web")

  // Seguridad de sesion y login.
  duracionSesionHoras  Int      @default(24) @map("duracion_sesion_horas")
  maxIntentosLogin     Int      @default(5) @map("max_intentos_login")
  minutosBloqueoLogin  Int      @default(15) @map("minutos_bloqueo_login")

  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedPor           String?  @map("updated_por")

  @@map("system_config")
}

model Termination {
  id                     String               @id @default(uuid())
  employeeId             String               @map("employee_id")
  fechaDesvinculacion    DateTime             @map("fecha_desvinculacion")
  fechaDevolucionEquipos DateTime?            @map("fecha_devolucion_equipos")
  estadoNotebook         EstadoDevolucionTipo @default(pendiente) @map("estado_notebook")
  estadoCelular          EstadoDevolucionTipo @default(pendiente) @map("estado_celular")
  estadoMonitor          EstadoDevolucionTipo @default(pendiente) @map("estado_monitor")
  estadoKit              EstadoDevolucionTipo @default(pendiente) @map("estado_kit")
  numeroTelefonoCelular  String?              @map("numero_telefono_celular") // Nro telefono del celular devuelto
  imeiCelular            String?              @map("imei_celular") // IMEI del celular devuelto
  recibidoPor            String?              @map("recibido_por")
  lugarDevolucion        String?              @map("lugar_devolucion")
  requiereDescuento      Boolean              @default(false) @map("requiere_descuento")
  montoDescuento         Decimal?             @map("monto_descuento") @db.Decimal(10, 2)
  motivoDescuento        String?              @map("motivo_descuento")
  notificadoRrhh         Boolean              @default(false) @map("notificado_rrhh")
  fechaNotificacionRrhh  DateTime?            @map("fecha_notificacion_rrhh")
  observaciones          String?
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  employee               Employee             @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([notificadoRrhh])
  @@index([fechaDesvinculacion])
  @@map("terminations")
}

model DispatchGuide {
  id                   String              @id @default(uuid())
  numero               String              @unique
  // Numero de seguimiento de Chilexpress -- todo despacho pasa por ahi, es
  // el dato principal de la guia. Ver discusion de rediseño (10-sep-2026).
  otChilexpress        String              @map("ot_chilexpress")
  fechaDespacho        DateTime            @map("fecha_despacho")
  fechaEstimadaLlegada DateTime?           @map("fecha_estimada_llegada")
  // Emisor: se autocompleta con el tecnico de la sesion al crear la guia.
  despachadoPor        String              @map("despachado_por")
  // Receptor: quien firma la recepcion fisica del paquete. Es texto libre
  // a proposito -- no siempre es un Employee del sistema (puede ser alguien
  // no onboardeado todavia). Ver discusion de rediseño (10-sep-2026).
  receptorNombre       String              @map("receptor_nombre")
  receptorRut          String              @map("receptor_rut")
  observaciones        String?
  // Solo dos estados: la guia nace `despachado` (el efecto sobre los
  // activos ya se aplico al crearla -- ver POST) y pasa a `realizado`
  // cuando alguien confirma que llego fisicamente. Esa confirmacion es
  // puramente informativa, no dispara ningun cambio de datos. La guia no
  // se puede anular una vez creada.
  estado               EstadoGuia          @default(despachado)
  fechaRecepcion       DateTime?           @map("fecha_recepcion")
  recibidoPor          String?             @map("recibido_por")
  // Sede destino: obligatoria, se elige explicitamente en el formulario.
  // Al crear la guia, cada activo despachado cambia de inmediato a esta
  // sede (ver POST /api/guias-despacho).
  sedeDestinoId        String              @map("sede_destino_id")
  // Sede de quien crea la guia (el emisor) -- junto con sedeDestinoId
  // determina que soporte puede ver/actuar sobre el registro. Ver SPEC 2.9.
  sedeId               String?             @map("sede_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  items                DispatchGuideItem[]
  sede                 Sede?               @relation("GuiasSede", fields: [sedeId], references: [id])
  sedeDestino          Sede                @relation("GuiasDestino", fields: [sedeDestinoId], references: [id])

  @@index([numero])
  @@index([estado])
  @@index([fechaDespacho])
  @@index([sedeId])
  @@index([sedeDestinoId])
  @@map("dispatch_guides")
}

model Sede {
  id        String   @id @default(uuid())
  // Slug corto y estable (ej: STGO, CCP). No cambia aunque el nombre
  // visible cambie -- es lo que idealmente se referencia en integraciones
  // futuras. Ver SPEC 2.9.
  codigo    String   @unique
  nombre    String
  // Permite desactivar una sede sin perder el historial de activos/guias
  // que la referencian.
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  assets       Asset[]
  empleados    Employee[]
  usuarios     SystemUser[]
  solicitudes  WorkflowRequest[]
  guias        DispatchGuide[]   @relation("GuiasSede")
  guiasDestino DispatchGuide[]   @relation("GuiasDestino")
  kitItems     WelcomeKitItem[]
  compras      Purchase[]

  @@map("sedes")
}

model DispatchGuideItem {
  id            String        @id @default(uuid())
  guideId       String        @map("guide_id")
  assetId       String        @map("asset_id")
  observaciones String?
  createdAt     DateTime      @default(now()) @map("created_at")
  asset         Asset         @relation(fields: [assetId], references: [id])
  guide         DispatchGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([assetId])
  @@map("dispatch_guide_items")
}

model WorkflowRequest {
  id                    String              @id @default(uuid())
  numero                String              @unique
  tipo                  TipoSolicitud
  estado                EstadoSolicitud
  employeeId            String              @map("employee_id")
  solicitanteId         String              @map("solicitante_id")
  responsableActualId   String?             @map("responsable_actual_id")
  // Campos onboarding
  fechaIngreso          DateTime?           @map("fecha_ingreso")
  cargoSolicitado       String?             @map("cargo_solicitado")
  ubicacionDestino      String?             @map("ubicacion_destino")
  categoriasRequeridas  String[]            @default([]) @map("categorias_requeridas")
  // Coordinacion de entrega (onboarding): se llena en la etapa "Coordinando
  // Entrega", despues de asignar los equipos y antes de darlos por entregados.
  // Si medioEntrega es presencial se usa lugarEntrega y fechaEntregaCoordinada
  // es la fecha/hora real de la visita; si es despacho (Chilexpress) se usan
  // otChilexpressEntrega + ciudadEntrega, y fechaEntregaCoordinada pasa a ser
  // la fecha ESTIMADA de llegada (mismo patron que medioCambio/ciudadCambio
  // mas abajo).
  fechaEntregaCoordinada DateTime?          @map("fecha_entrega_coordinada")
  medioEntrega           String?            @map("medio_entrega")
  lugarEntrega           String?            @map("lugar_entrega")
  otChilexpressEntrega   String?            @map("ot_chilexpress_entrega")
  ciudadEntrega          String?            @map("ciudad_entrega")
  // Kit de Bienvenida y EPP ya no son categorias de Activos (ver
  // WelcomeKitItem): la intencion se guarda aparte como estos dos flags,
  // y la entrega real (que articulos especificos, con que cantidad) se
  // registra en KitAssignment cuando Gestion TI la concreta.
  kitBienvenidaSolicitado Boolean           @default(false) @map("kit_bienvenida_solicitado")
  eppSolicitado           Boolean           @default(false) @map("epp_solicitado")
  // Campos cambio equipo
  motivoCambio          String?             @map("motivo_cambio")
  // Coordinacion de cambio (cambio_equipo): se llena en la etapa "Coordinando
  // Cambio", ANTES de ejecutar el cambio (a diferencia de la coordinacion de
  // entrega de onboarding, que se llena despues de asignar). Mismo patron
  // presencial/OT que las otras dos coordinaciones: si medioCambio es
  // presencial se usa lugarCambio; si es despacho (Chilexpress) se usan
  // otCambioChilexpress + ciudadCambio, y fechaCambioCoordinada pasa a ser la
  // fecha estimada de llegada en vez de la fecha/hora de la visita.
  medioCambio           String?             @map("medio_cambio")
  fechaCambioCoordinada DateTime?           @map("fecha_cambio_coordinada")
  lugarCambio           String?             @map("lugar_cambio")
  otCambioChilexpress   String?             @map("ot_cambio_chilexpress")
  ciudadCambio          String?             @map("ciudad_cambio")
  // Campos devolución
  fechaDesvinculacion   DateTime?           @map("fecha_desvinculacion")
  medioDevolucion       String?             @map("medio_devolucion")
  otChilexpress         String?             @map("ot_chilexpress")
  ciudadDevolucion      String?             @map("ciudad_devolucion")
  // Coordinacion de devolucion (offboarding): se llena en la etapa
  // "Coordinando Devolucion", ANTES de recibir los equipos. lugarDevolucion es
  // el analogo presencial de ciudadDevolucion (que en la practica se usa como
  // destino del despacho OT); fechaDevolucionCoordinada es la fecha/hora de
  // la visita presencial, o la fecha estimada de llegada si es por OT.
  fechaDevolucionCoordinada DateTime?       @map("fecha_devolucion_coordinada")
  lugarDevolucion       String?             @map("lugar_devolucion")
  // Referencias a registros creados
  assignmentIds         String[]            @map("assignment_ids")
  // Igual que assignmentIds pero para devoluciones de EPP (KitAssignment):
  // se necesita para poder mostrar en el detalle del ticket que EPP se
  // devolvio, con su estado y observaciones -- employee.kitAssignments
  // trae TODO el historico del empleado, no solo lo de este ticket.
  kitReturnIds           String[]            @default([]) @map("kit_return_ids")
  terminationId         String?             @map("termination_id")
  dispatchGuideId       String?             @map("dispatch_guide_id")
  // Sede de quien creo la solicitud -- determina que soporte la ve.
  // Ver SPEC 2.9.
  sedeId                String?             @map("sede_id")
  // General
  observaciones         String?
  fechaCierre           DateTime?           @map("fecha_cierre")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  employee              Employee            @relation(fields: [employeeId], references: [id])
  solicitante           SystemUser          @relation("SolicitanteRelation", fields: [solicitanteId], references: [id])
  responsableActual     SystemUser?         @relation("ResponsableRelation", fields: [responsableActualId], references: [id])
  sede                  Sede?               @relation(fields: [sedeId], references: [id])
  comments              WorkflowComment[]
  transitions           WorkflowTransition[]
  pendientes            WorkflowPendiente[]
  kitAssignments        KitAssignment[]
  kitRequeridos         RequestKitItem[]

  @@index([tipo])
  @@index([estado])
  @@index([employeeId])
  @@index([solicitanteId])
  @@index([responsableActualId])
  @@index([createdAt])
  @@index([sedeId])
  @@map("workflow_requests")
}

model WorkflowComment {
  id          String          @id @default(uuid())
  requestId   String          @map("request_id")
  autorId     String          @map("autor_id")
  mensaje     String
  esInterno   Boolean         @default(false) @map("es_interno")
  createdAt   DateTime        @default(now()) @map("created_at")

  request     WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  autor       SystemUser      @relation(fields: [autorId], references: [id])

  @@index([requestId])
  @@index([autorId])
  @@map("workflow_comments")
}

model WorkflowTransition {
  id              String          @id @default(uuid())
  requestId       String          @map("request_id")
  estadoAnterior  EstadoSolicitud @map("estado_anterior")
  estadoNuevo     EstadoSolicitud @map("estado_nuevo")
  ejecutadoPorId  String          @map("ejecutado_por_id")
  comentario      String?
  datosAccion     Json?           @map("datos_accion")
  createdAt       DateTime        @default(now()) @map("created_at")

  request         WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ejecutadoPor    SystemUser      @relation(fields: [ejecutadoPorId], references: [id])

  @@index([requestId])
  @@index([createdAt])
  @@map("workflow_transitions")
}

model WorkflowPendiente {
  id              String          @id @default(uuid())
  requestId       String          @map("request_id")
  tipo            TipoPendiente
  estado          EstadoPendiente @default(pendiente)
  descripcion     String?
  actualizadoPor  String?         @map("actualizado_por")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  request         WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([estado])
  @@map("workflow_pendientes")
}

// Solo dos roles reales: admin (ve y administra todo) y tecnico (soporte
// operativo, restringido a su sede -- ver sedeScope()). supervisor/rrhh/
// auditor se retiraron: el sistema es de soporte, esos roles no lo usaban
// en la practica.
enum SystemRole {
  admin
  tecnico
}

enum TipoContrato {
  contrato
  boleta
}

enum EstadoEmpleado {
  activo
  desvinculado
  licencia
}

// 15-sep-2026 (SPEC 2.40): se elimina "reutilizable". Era indistinguible de
// "disponible" para entregar un equipo (el formulario de asignacion aceptaba
// los dos) pero NO contaba como stock en las alertas del Dashboard, asi que
// con equipos devueltos y listos el sistema igual avisaba "Sin Stock". Lo
// que ese estado queria decir -- que el equipo ya se uso -- lo dice
// `condicion` (nuevo/usado/danado), que es una dimension aparte del ciclo
// de vida.
enum EstadoActivo {
  disponible
  asignado
  en_mantencion
  baja
  vendido
}

enum CondicionActivo {
  nuevo
  usado
  danado
}

enum TipoCompra {
  FACTURA
  GASTO_MENOR
}

enum TipoMovimiento {
  ingreso
  cambio
  reemplazo
  temporal
}

enum EstadoDevolucion {
  ok
  danado
  incompleto
  // El empleado no entrego el equipo (se fue con el, se perdio). El Activo
  // sale del parque util igual que uno danado, pero por otro motivo.
  no_devuelto
}

enum CategoriaKit {
  kit_bienvenida
  epp
}

/// Estado de cada articulo de Kit/EPP que una solicitud pidio (RequestKitItem).
enum EstadoKitRequerido {
  pendiente
  entregado
  // Se decidio que ese articulo no corresponde entregarlo (no hay stock y no
  // se va a reponer, el cargo no lo necesita, se entrego por fuera...). Deja
  // de bloquear el cierre del ticket, pero queda registrado con su motivo.
  no_aplica
}

enum EstadoKit {
  entregado
  devuelto
  perdido
  no_devuelto
}

enum EstadoMantencion {
  pendiente
  en_proceso
  completada
  cancelada
}

enum TipoEvento {
  creacion
  asignacion
  devolucion
  mantencion
  cambio_estado
  actualizacion_specs
  baja
  venta
  solicitud_workflow
  // Cambio de sede fisica del activo, via guia de despacho tipo traslado
  // recibida. Ver SPEC 2.9.
  traslado
  // Vinculacion de un activo YA EXISTENTE a una compra/factura (14-sep-2026,
  // SPEC 2.25). Antes solo quedaba historial cuando el activo se CREABA
  // desde el alta rapida de Nueva Compra -- vincular uno ya existente no
  // dejaba ningun rastro de esa asociacion.
  compra
}

// AuditLog (SPEC 2.29 y SPEC 2.31): entidades cubiertas -- Proveedores queda
// afuera a proposito (tabla sin uso, se va a eliminar). Activos y
// Solicitudes tampoco estan aca porque ya tienen su propio historial mas
// detallado (AssetHistory / WorkflowTransition.ejecutadoPorId) -- decision
// explicita de Javier de no unificarlos, ver SPEC 2.31.
enum AuditEntidad {
  empleado
  compra
  usuario
  mantencion
  guia_despacho
  desvinculacion
  kit_item
  sede
  categoria
  tipo_mantencion
  // Agregado 14-sep-2026 junto con SystemConfig: cambios a datos de empresa
  // o seguridad (duracion de sesion, intentos de login) tambien quedan
  // auditados -- es configuracion sensible, tiene sentido saber quien la
  // toco.
  configuracion
}

enum AuditAccion {
  crear
  actualizar
  eliminar
}

enum TipoSolicitud {
  onboarding
  cambio_equipo
  offboarding
}

enum EstadoSolicitud {
  // Onboarding
  solicitud_recibida
  gestion_ti
  coordinando_entrega
  equipos_entregados
  registro_rrhh
  // Cambio equipo
  incidencia_detectada
  // Coordinacion del cambio (fecha/lugar presencial, u OT + fecha estimada
  // de llegada), ANTES de ejecutarlo -- ver SPEC 2.5.2 regla 9.
  coordinando_cambio
  cambio_ejecutado
  confirmacion_rrhh
  // Devolución
  solicitud_emitida
  // Coordinacion de la devolucion (fecha/lugar presencial, u OT + fecha
  // estimada de llegada), ANTES de recibir los equipos. Este valor ya
  // existia en el enum (sin usar) desde antes -- ahora se conecta a
  // TRANSITIONS/STATES_BY_TYPE -- ver SPEC 2.5.2 regla 9.
  coordinacion_en_curso
  equipo_recibido
  consolidacion_cierre
  // Cancelación (los tres tipos) -- solo antes de ejecutar efectos
  // secundarios; ver SPEC 2.5.2/2.5.3 y POST /api/solicitudes/[id]/cancelar
  cancelada
}

enum TipoPendiente {
  celular
  audifonos
  mochila
  cargador
  epp_zapatos
  epp_chaleco
  epp_casco
  epp_lentes
  kit_bienvenida
  epp
  otro
}

enum EstadoPendiente {
  pendiente
  gestionando
  entregado
  no_aplica
}

enum EstadoDevolucionTipo {
  ok
  danado
  no_aplica
  pendiente
}

enum EstadoGuia {
  despachado
  realizado
}
